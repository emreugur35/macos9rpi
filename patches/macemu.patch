@@ -46,6 +46,26 @@ public:
 	void init()
 		{ mask = 0; lock = SPIN_LOCK_UNLOCKED; }
 
+#ifdef CIRCLE_PORT
+	// set() is called from IRQ context on the bare-metal port: use atomics
+	bool empty() const
+		{ return (__atomic_load_n(&mask, __ATOMIC_RELAXED) == 0); }
+
+	bool test(uint32 v) const
+		{ return (__atomic_load_n(&mask, __ATOMIC_RELAXED) & v); }
+
+	void init(uint32 v)
+		{ __atomic_store_n(&mask, v, __ATOMIC_SEQ_CST); }
+
+	uint32 get() const
+		{ return __atomic_load_n(&mask, __ATOMIC_RELAXED); }
+
+	void set(uint32 v)
+		{ __atomic_fetch_or(&mask, v, __ATOMIC_SEQ_CST); }
+
+	void clear(uint32 v)
+		{ __atomic_fetch_and(&mask, ~v, __ATOMIC_SEQ_CST); }
+#else
 	bool empty() const
 		{ return (mask == 0); }
 
@@ -63,6 +83,7 @@ public:
 
 	void clear(uint32 v)
